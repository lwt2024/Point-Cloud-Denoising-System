# Copy to .env in the repository root. Never commit secrets.
PCDS_STORAGE_DIR=./storage
PCDS_CORS_ORIGINS=http://localhost:5173
# Reserved for the future remote adapter; not consumed by this scaffold.
# SSH private key remains on the backend host. Verify host keys; never auto-trust.
AUTODL_HOST=
AUTODL_PORT=22
AUTODL_USER=
AUTODL_PRIVATE_KEY_PATH=
AUTODL_KNOWN_HOSTS_PATH=
AUTODL_WORK_DIR=
AUTODL_ALGORITHM_ENTRY=
