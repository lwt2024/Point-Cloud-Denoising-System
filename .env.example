# Copy to .env in the repository root. Never commit secrets.
PCDS_STORAGE_DIR=./storage
PCDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: python -m app.bootstrap (from backend/ or with PYTHONPATH=backend).
# Initial administrator account; only used when the database has no administrator.
PCDS_ADMIN_USERNAME=admin
PCDS_ADMIN_PASSWORD=
# false for localhost HTTP; set true when serving through HTTPS.
PCDS_COOKIE_SECURE=false
# Legacy PCDS_ADMIN_TOKEN is no longer accepted. Use account login.
# Optional passphrase for an encrypted SSH private key. Backend only; restart after editing.
AUTODL_KEY_PASSPHRASE=
# Host/port/verified fingerprint/model paths are saved via System Settings
# SSH login passwords are request-only and must not be saved in this file.
# in ignored storage/autodl/config.json. Private key contents are never uploaded.
